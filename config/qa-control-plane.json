      "stubbedMutationAsWorkflowAccepted": false,
      "structuralInventoryAsProductCoverageAccepted": false
    },
    "lanes": {
      "smoke": {
        "environment": "production",
        "allowedMethods": ["GET"],
        "forbiddenActions": ["submit", "mutate", "export", "download", "upload", "send"]
      },
      "e2e": {
        "environments": ["dev", "qa"],
        "persistentMutationRequires": [
          "syntheticOwnedIdentity",
          "knownBaseline",
          "exactRequestAndResult",
          "prohibitedOutcome",
          "verifiedCleanup"
        ]
      },
      "backend": {
        "persistentMutationRequires": [
          "syntheticOwnedIdentity",
          "exactApiContract",
          "exactDatabaseState",
          "prohibitedNoWrite",
          "verifiedCleanup"
        ]
      }
    },
    "fullChainRequires": [
      "approvedIntent",
      "controlledStartingState",
      "realUiMutation",
      "exactUiRequestAndResult",
      "directApiContract",
      "exactDatabaseOrNoWrite",
      "downstreamReconciliationWhenApplicable",
      "verifiedCleanup"
    ]
  },
