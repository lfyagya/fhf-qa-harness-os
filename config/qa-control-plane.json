  "approval": {
    "jiraWrites": true,
    "confluenceWrites": true,
    "applicationSpecWrites": true,
    "evidenceExport": true,
    "singleUse": true
  },
  "connectors": {
    "atlassianMcp": {
      "required": true,
      "sources": [
        "jira",
        "confluence",
        "teamworkGraph"
      ],
      "authentication": "oauth"
    },
    "cypressCloud": {
      "required": false,
      "queryOrder": [
        "cloud-mcp",
        "cloud-cli",
        "local-junit"
      ],
      "fallback": "local-junit",
      "cli": {
        "documentation": "https://docs.cypress.io/cloud/integrations/cloud-cli",
        "package": "@cypress/cloud",
        "command": "cy-cloud",
        "installation": "global",
        "minimumNodeVersion": "22.21.0",
        "projectIdSource": "cypress.config.js",
        "authentication": {
          "local": "oauth",
          "ciTokenEnv": "CYPRESS_CLOUD_TOKEN",
          "credentialsInConfig": false
        },
        "laneAccess": {
          "e2e": "full-read",
          "smoke": "metadata-only",
          "root": "metadata-only"
        },
        "guard": {
          "safeNoNetworkFlags": [
            "--help",
            "--schema"
          ],
          "inlineCredentialPatterns": [
            "\\b(?:cy-cloud|npx\\s+(?:--yes\\s+)?@cypress/cloud)\\s+login\\b[^\\r\\n;&|]*--token(?:\\s|=)",
            "\\bCYPRESS_CLOUD_TOKEN\\s*="
          ],
          "productionSensitivePatterns": [
            "\\b(?:cy-cloud|npx\\s+(?:--yes\\s+)?@cypress/cloud)\\s+replay\\s+(?:info|timeline)\\b",
            "\\b(?:cy-cloud|npx\\s+(?:--yes\\s+)?@cypress/cloud)\\s+test\\s+get\\b[^\\r\\n;&|]*--screenshot(?:\\s|=|$)"
          ]
        }
      }
    },
    "testRail": {
      "required": false,
      "fallback": "run-id-and-junit-artifacts"
    }
  },
  "freshnessDays": {
    "sprintSnapshot": 1,
    "coverage": 7,
    "execution": 14
  },
  "metricThresholds": {
    "uiCoveragePercent": 50,
    "jiraTraceabilityPercent": 100,
    "maxUnmappedSprintPercent": 10,
    "maxReviewQueuePercent": 20,
    "maxExecutionAgeDays": 14
  },
