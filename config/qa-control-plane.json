  "connectors": {
    "atlassianMcp": {
      "required": false,
      "availability": "optional",
      "sources": [
        "jira",
        "confluence",
        "teamworkGraph"
      ],
      "authentication": "oauth",
      "transport": "claude.ai-connector",
      "laneAccess": {
        "root": "required-for-command-center",
        "e2e": "optional",
        "smoke": "optional"
      }
    },
    "cypressCloud": {
      "required": false,
      "queryOrder": [
        "cloud-mcp",
        "cloud-cli",
        "local-junit"
      ],
      "fallback": "local-junit",
      "cli": {
        "documentation": "https://docs.cypress.io/cloud/integrations/cloud-cli",
        "package": "@cypress/cloud",
        "command": "cy-cloud",
        "installation": "global",
        "minimumNodeVersion": "22.21.0",
        "projectIdSource": "cypress.config.js",
        "authentication": {
          "local": "oauth",
          "ciTokenEnv": "CYPRESS_CLOUD_TOKEN",
          "credentialsInConfig": false
        },
        "laneAccess": {
          "e2e": "full-read",
          "smoke": "metadata-only",
          "root": "metadata-only"
        },
        "guard": {
          "safeNoNetworkFlags": [
            "--help",
            "--schema"
          ],
          "inlineCredentialPatterns": [
            "\\b(?:cy-cloud|npx\\s+(?:--yes\\s+)?@cypress/cloud)\\s+login\\b[^\\r\\n;&|]*--token(?:\\s|=)",
            "\\bCYPRESS_CLOUD_TOKEN\\s*="
          ],
          "productionSensitivePatterns": [
            "\\b(?:cy-cloud|npx\\s+(?:--yes\\s+)?@cypress/cloud)\\s+replay\\s+(?:info|timeline)\\b",
            "\\b(?:cy-cloud|npx\\s+(?:--yes\\s+)?@cypress/cloud)\\s+test\\s+get\\b[^\\r\\n;&|]*--screenshot(?:\\s|=|$)"
          ]
        },
        "e2eReplayRecipe": "FHF_LANE=e2e cy-cloud replay timeline --testId <id> --aroundFailure 5 --commands --network --logs"
      },
      "preflightScript": "scripts/execution/cloud-access-doctor.mjs",
      "projects": {
        "e2e": "nptdoe",
        "smoke": "r5k1ro"
      },
      "smartOrchestration": {
        "rerunOptimization": {
          "docs": "https://docs.cypress.io/cloud/features/smart-orchestration/rerun-optimization",
          "cloudSetting": "Run only failed specs",
          "ownerAction": "Enable in Cypress Cloud Smart Orchestration for projects nptdoe and r5k1ro",
          "ciEnv": {
            "groupId": "CYPRESS_RERUN_GROUP_ID",
            "forceAll": "CYPRESS_RERUN_ALL_TESTS"
          }
        },
        "specPrioritization": true,
        "autoCancellation": "optional-plan-dependent"
      }
    },
    "testRail": {
      "required": false,
      "fallback": "run-id-and-junit-artifacts",
      "laneAccess": {
        "backend": "full-read"
      },
      "artifacts": [
        "reports/junit-report.xml",
        "reports/testrail_run_id.txt"
      ],
      "idPattern": "\\[C\\d+\\]",
      "uploadDefaultOnDemand": false
    }
  },
