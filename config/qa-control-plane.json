  "_moduleSpecPathsNote": "Prefer each module's own module-context.yaml: consumers take path.dirname() of these entries to locate the module directory, so a specs/*.yaml target resolves one level too deep. call-reports, post-funding and contracts have no module-context.yaml of their own and point at their real spec files instead. letters has no application-intelligence directory at all, so it has no entry (consumers default to []).",
  "moduleSpecPaths": {
    "ancillary": [
      "docs/framework/application-intelligence/modules/ancillary/module-context.yaml"
    ],
    "call-reports": [
      "docs/framework/application-intelligence/modules/call_reports/specs/agent-call-volume.yaml",
      "docs/framework/application-intelligence/modules/call_reports/specs/call-recording.yaml"
    ],
    "checks": [
      "docs/framework/application-intelligence/modules/checks/module-context.yaml"
    ],
    "complaints": [
      "docs/framework/application-intelligence/modules/complaints/module-context.yaml"
    ],
    "contracts": [
