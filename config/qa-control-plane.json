  "engineering": {
    "context": {
      "mode": "route-on-demand",
      "duplicateMatchLimit": 5,
      "effortLevel": "high",
      "autoCompact": {
        "enabled": true,
        "windowTokens": null
      },
      "readOutput": {
        "maxLines": 120,
        "unboundedReadMaxBytes": 2048
      },
      "skillListing": {
        "maxDescriptionChars": 240,
        "budgetFraction": 0.015
      },
      "runtimeOverlay": {
        "version": 1,
        "overlayEnv": "FHF_HARNESS_OVERLAY",
        "allowedSections": [
          "session",
          "context",
          "loops"
        ],
        "sessionFields": [
          "ticket",
          "module",
          "routeId",
          "reason",
          "runId"
        ],
        "mutablePaths": {
          "context.readOutput.maxLines": "lower-or-equal",
          "context.readOutput.unboundedReadMaxBytes": "lower-or-equal",
          "loops.sameFailureLimit": "lower-or-equal",
          "loops.gateRepairLimit": "lower-or-equal",
          "loops.specSweepLimit": "lower-or-equal"
        }
      },
      "evaluation": {
        "goldenRoutes": "scripts/harness/evals/routes.golden.json",
        "calibrationCases": "scripts/harness/evals/gate-calibration.json",
        "thresholds": {
          "routeAccuracy": 1,
          "minimumCalibrationKappa": 0.6,
          "minimumCalibrationRho": 0.8,
          "minimumRepairConvergence": 0.8
        }
      },
      "runtime": {
        "stateFile": "cypress/handoff/loop-state.json",
        "traceFile": "cypress/handoff/loop-trace.jsonl",
        "stateSchema": "fhf-harness/loop-state/v1",
        "traceSchema": "fhf-harness/trace/v1",
        "redactPatterns": [
          "(?:token|password|secret|authorization|cookie)\\s*[:=]\\s*[^\\s,;]+",
          "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b"
        ]
      },
      "topicDriftSignals": [
        "also can you",
        "while we're here",
        "one more thing",
        "and also",
        "by the way",
        "oh and"
      ],
      "routes": [
        {
          "id": "documentation",
          "priority": 10,
          "match": "\\b(documentation|docs?|context noise|duplicate docs?|source of truth)\\b",
          "hint": "Documentation task → read docs/README.md, then the one path in .claude/harness.config.json documentation.owners. Update or delete; do not create another report."
        },
        {
          "id": "qa-control-plane",
          "priority": 90,
          "match": "\\b(command center|current sprint|sprint intake|spec (sync|freshness|delta)|centralized qa|cross-lane)\\b",
          "hint": "QA control plane → follow the repository's QA control-plane guide when available; otherwise use repository-local rules. Approval-gate every Jira, Confluence, or application-spec write."
        },
        {
          "id": "cloud-failure",
          "priority": 100,
          "match": "cloud\\.cypress\\.io|cypress cloud.*(fail|run)",
          "hint": "Cypress Cloud run → spawn cypress-debugger at the standard tier; pull E2E `cy-cloud replay timeline --aroundFailure 5 --commands --network --logs` before fixing. Frontier escalation requires verified evidence that the standard diagnosis is insufficient. Follow connectors.cypressCloud.queryOrder and laneAccess."
        },
        {
          "id": "test-failure",
          "priority": 100,
          "match": "\\b(failing|fails|red|broken|error)\\b.*\\b(test|spec)\\b|\\b(test|spec)\\b.*\\b(failing|fails|red|broken)\\b",
          "hint": "Failing test → spawn cypress-debugger (root cause + fix + regression test, configured escalation limit)."
        },
        {
          "id": "test-flake",
          "priority": 100,
          "match": "\\b(flaky|slow|intermittent)\\b.*\\b(test|spec|suite)\\b",
          "hint": "Flakiness/performance → spawn cypress-debugger."
        },
        {
          "id": "jira-implementation",
          "priority": 95,
          "match": "\\bacceptance criteria\\b|\\bserv-\\d+",
          "hint": "Jira ticket → spawn cypress-generator (scenarios + spec, one pass)."
        },
        {
          "id": "legacy-migration",
          "priority": 95,
          "match": "\\b(migrate|migration)\\b.*\\b(actions|page.?object)",
          "hint": "Legacy migration → spawn cypress-generator."
        },
        {
          "id": "pre-merge",
          "priority": 95,
          "match": "\\b(pre-?merge|ready to (commit|merge))\\b",
          "hint": "Pre-merge → spawn cypress-gate for the verdict."
        },
        {
          "id": "pull-request",
          "priority": 95,
          "match": "\\b(open (a )?pr|pull request)\\b",
          "hint": "Open a PR → spawn cypress-shipper."
        },
        {
          "id": "test-explanation",
          "priority": 80,
          "match": "\\b(explain|how does|review)\\b.*\\b(test|spec)\\b",
          "hint": "Explain/review only, no edits → cypress-explain skill. Need a merge verdict instead → spawn cypress-gate."
        },
        {
          "id": "coverage-report",
          "priority": 85,
          "match": "\\bui coverage|coverage gap|automation (backlog|roadmap)|risk matrix\\b",
          "hint": "Coverage/backlog/risk report → spawn cypress-shipper; use coverage-computed.json, the chain ledger, and the planning ledger."
        },
        {
          "id": "new-test",
          "priority": 95,
          "match": "\\b(write|create|add|new|generate)\\b.*\\b(test|spec|suite)\\b",
          "hint": "New test → spawn cypress-generator."
        },
        {
          "id": "api-interception",
          "priority": 70,
          "match": "\\b(intercept|api alias|api wait)\\b",
          "hint": "API interception detail → read docs/framework/api-layer-guide.md in the E2E repo."
        },
        {
          "id": "coverage-presence",
          "priority": 90,
          "match": "\\b(current coverage|coverage state|test presence)\\b",
          "hint": "Current test presence → read docs/evidence/coverage-computed.json only."
        },
        {
          "id": "full-chain",
          "priority": 75,
          "match": "\\b(full.?chain|ui.?api.?db|chain status)\\b",
          "hint": "Full-chain evidence → read docs/planning/coverage/fullstack-chain-risk-matrix.md, then only the target module contract."
        },
        {
          "id": "planning",
          "priority": 60,
          "match": "\\b(priority|estimate|capacity|sequence|scope|impact measurement|planning)\\b",
          "hint": "Planning question → read docs/planning/roadmap/effort-breakdown-by-module-and-subdashboard.md only."
        },
        {
          "id": "selector-gap",
          "priority": 75,
          "match": "\\b(data-cy|selector hook|test hook)\\b",
          "hint": "Frontend testability gap → read docs/planning/data-cy-hook-backlog.md only."
        },
        {
          "id": "application-contract",
          "priority": 65,
          "match": "\\b(application contract|product behavior|module context|route.*permission|api.*database)\\b",
          "hint": "Product behavior → read the configured application contract owner, then the target module spec from moduleSpecPaths."
        },
        {
          "id": "triage-night-brief",
          "priority": 90,
          "match": "\\b(night brief|triage runbook|failed.?spec.?only|re-?run optimization|studio ai)\\b",
          "hint": "Cloud triage / re-run / Studio policy → read docs/framework/triage-runbook.md and docs/framework/execution-strategy.md; for failures spawn cypress-debugger (E2E replay timeline mandatory). Studio AI: .claude/rules/studio-ai-policy.md."
        },
        {
          "id": "regression-sprint-records",
          "priority": 95,
          "match": "\\b(regression (pack|plan|checklist|record|records|scope|design)|release confidence|sprint \\d+\\.\\d+(\\.\\d+)?)\\b",
          "hint": "Per-sprint regression pack → read documentation.owners['regression-sprint-records'] at front-end-automation-e2e/docs/evidence/regression-effort/records/<sprint-id>/ (README.md, regression-plan.md, regression-checklist.yaml, release-confidence.md). The FHF meta-root docs/evidence/regression-effort/ keeps only the workflow and templates; records moved out 2026-08-17. Resolve the path directly and list the directory — content search skips that nested repository, so a text search will report the pack as absent. Never answer a sprint regression question from the meta-root strategy docs."
        }
      ]
    },
    "memory": {
      "authority": "working-tree-config-and-generated-evidence",
      "sessionScope": "one-job",
      "handoffFile": "cypress/handoff/session-latest.json",
      "handoffMaxAgeHours": 24,
      "preserveExactly": [
        "ticket-ids",
        "module-and-spec",
        "selectors",
        "endpoints",
        "evidence-paths"
      ],
      "factExtractors": [
        {
          "name": "ticket-ids",
          "match": "\\bSERV-\\d+\\b",
          "flags": "gi"
        },
        {
          "name": "module-and-spec",
          "match": "(?:[a-z0-9_. -]+[\\\\/])*[a-z0-9_.-]+\\.cy\\.(?:js|ts)|\\b(?:module|dashboard)\\s*[:=]?\\s*[a-z][a-z0-9_-]{2,30}\\b",
          "flags": "gi"
        },
        {
          "name": "selectors",
          "match": "\\[data-cy(?:\\^|\\$|\\*)?=[\"'][^\"']+[\"']\\]|\\bdata-cy[=:][\"']?[a-z0-9_-]+",
          "flags": "gi"
        },
        {
          "name": "endpoints",
          "match": "\\/api\\/[a-z0-9_./:{}-]+|/firsthelp_coll/[a-z0-9_./-]+",
          "flags": "gi"
        },
        {
          "name": "oracle-objects",
          "match": "\\b(?:FIRSTHELP_COLL|FIRSTHELP_LETTERS|FHF_DOC)\\.[A-Z0-9_]+\\b",
          "flags": "g"
        },
        {
          "name": "testrail-ids",
          "match": "\\[C\\d+\\]",
          "flags": "gi"
        },
        {
          "name": "evidence-paths",
          "match": "(?:docs\\/evidence|reports\\/junit|cypress\\/handoff)\\/[a-z0-9_./-]+",
          "flags": "gi"
        }
      ],
      "obsidian": {
        "authority": "derived-only",
        "writeBack": false
      }
    },
    "harness": {
      "agents": [
        "cypress-generator",
        "cypress-gate",
        "cypress-debugger",
        "cypress-shipper"
      ],
      "skills": [
        "cypress-explain",
        "cypress-docs"
      ],
      "boundaries": {
        "applicationSource": {
          "mode": "read-only",
          "pathPatterns": [
            "fhf-dashboards[\\\\/]src(?:[\\\\/]|$)",
            "(?:^|[\\\\/])fhf-backend-automation(?:[\\\\/]|$)",
            "(?:^|[\\\\/])tests[\\\\/]\\.env$",
            "(?:^|[\\\\/])config[\\\\/]config\\.ini$"
          ],
          "denyWriteByLane": {
            "root": [
              "./fhf-dashboards/src"
            ],
            "e2e": [
              "../fhf-dashboards/src"
            ],
            "smoke": [
              "../fhf-dashboards/src"
            ]
          }
        }
      },
      "hooks": {
        "sessionStart": [
          "session-context.mjs"
        ],
        "prompt": [
          "prompt-router.mjs"
        ],
        "preWrite": [
          "protect-app-source.mjs",
          "protect-second-brain-boundary.mjs",
          "pre-validate-cypress-rules.mjs"
        ],
        "preShell": [
          "manual-task-guard.mjs"
        ],
        "preSubagent": [
          "block-generic-agents.mjs"
        ],
        "preSkill": [
          "block-forbidden-skills.mjs"
        ],
        "preReadExceptE2e": [
          "protect-prod-data.mjs"
        ],
        "preRead": [
          "context-read-guard.mjs"
        ],
        "subagentStart": [
          "block-generic-agents.mjs"
        ],
        "postWrite": [
          "validate-cypress-rules.mjs",
          "scenario-file-guard.mjs",
          "scenario-content-guard.mjs",
          "artifact-duplication-guard.mjs",
          "coverage-strategy-guard.mjs",
          "sync-reminder.mjs"
        ],
        "postToolFailure": [
          "failure-loop-guard.mjs"
        ],
        "preCompact": [
          "memory-checkpoint.mjs"
        ],
        "sessionEnd": [
          "memory-checkpoint.mjs"
        ],
        "stop": [
          "session-end-reminder.mjs",
          "spec-sweep-stop-hook.mjs"
        ]
      },
      "adapters": {
        "claudeCode": {
          "autoCompactWindowEnv": "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
          "skillOverrides": {
            "statusline-setup": "name-only",
            "keybindings-help": "name-only",
            "fewer-permission-prompts": "name-only",
            "claude-api": "name-only",
            "update-config": "name-only",
            "simplify": "name-only",
            "init": "name-only",
            "security-review": "name-only",
            "loop": "name-only",
            "run": "name-only",
            "verify": "name-only"
          },
          "permissions": {
            "allow": [
              "Bash(npm run lint*)",
              "Bash(npm run check*)",
              "Bash(npm run files:manage)",
              "Bash(npm run folders:manage)",
              "Bash(npm run cy:run*)",
              "Bash(npx cypress*)",
              "Bash(grep -r* cypress/*)",
              "Bash(find cypress/*)"
            ],
            "deny": [
              "WebSearch"
            ]
          }
        },
        "cursor": {
          "promptRouting": "session-context",
          "compatibleHookDeduplication": "identical-command"
        },
        "codex": {
          "instructionFile": "AGENTS.md",
          "hookCapability": "instruction-only"
        }
      },
      "genericAgents": [
        "general-purpose",
        "explore"
      ],
      "forbiddenAgents": [
        "general-purpose",
        "explore",
        "documentation-writer",
        "test-execution-planner",
        "cypress-bug-hunter",
        "cypress-cloud-investigator",
        "cypress-e2e-automation",
        "cypress-explorer",
        "cypress-performance-auditor",
        "cypress-runner",
        "cypress-test-automation",
        "cypress-ui-coverage-analyst",
        "pr-creator",
        "pre-merge-qa-gate",
        "qa-ticket-router",
        "spec-generation-loop",
        "test-design-reviewer"
      ],
      "projection": ".claude/harness.config.json",
      "sync": "scripts/harness/sync-loader-shims.mjs",
      "verify": {
          "canonical": [
            "scripts/harness/check-loader-drift.mjs",
            "scripts/harness/check-docs-links.mjs",
            "scripts/harness/test-hooks.mjs",
            "scripts/harness/test-adapter-contract.mjs",
            "scripts/harness/test-sync-loader.mjs",
            "scripts/harness/test-runtime-state.mjs",
            "scripts/harness/test-evaluation-evidence.mjs",
            "scripts/harness/test-calibration.mjs",
            "scripts/harness/test-consumer-runtime.mjs",
            "scripts/harness/test-workspace-contract.mjs",
            "scripts/harness/test-execution-setup.mjs",
            "scripts/harness/eval-harness.mjs"
        ],
        "consumer": [
          ".harness/verify.mjs"
        ]
      }
    },
    "loops": {
      "sameFailureLimit": 3,
      "gateRepairLimit": 3,
      "specSweepLimit": 3,
      "phaseBoundary": "owner-approval",
      "terminalStates": [
        "completed",
        "blocked",
        "escalated"
      ]
    }
  },
  "policyGovernance": {
    "version": 1,
    "scope": "classification-placement-and-adoption-gates",
    "categories": {
      "regulatory": {
        "authority": "official-government-primary-source",
        "owner": "legal-compliance",
        "adoptionGate": "confirmed-applicability-and-owner-approval",
        "contentOwner": "application-contract-source-citation"
      },
      "public-commitment": {
        "authority": "official-first-help-financial-publication",
        "owner": "product-and-compliance",
        "adoptionGate": "effective-version-and-owner-approval",
        "contentOwner": "application-contract-source-citation"
      },
      "internal-business-policy": {
        "authority": "approved-versioned-fhf-policy",
        "owner": "named-business-owner",
        "adoptionGate": "approved",
        "contentOwner": "application-contract"
      },
      "application-contract": {
        "authority": "approved-product-specification",
        "owner": "documentation.owners.application",
        "adoptionGate": "approved",
        "contentOwner": "module-component-or-common-spec"
      },
      "implementation-observation": {
        "authority": "live-source-api-db",
        "owner": "implementing-system",
        "adoptionGate": "evidence-only",
        "contentOwner": "source-code-or-api-db-evidence"
      },
      "execution-evidence": {
        "authority": "generated-repository-evidence",
        "owner": "evidence-producer",
        "adoptionGate": "evidence-only",
        "contentOwner": "configured-evidence-owner"
      },
      "proposal": {
        "authority": "jira-confluence-web-research-or-derived-index",
        "owner": "requesting-owner",
        "adoptionGate": "proposal-only",
        "contentOwner": "approved-owner-review-queue"
      }
    },
    "adoptionStates": [
      "proposed",
      "approved",
      "retired"
    ],
    "applicabilityStates": [
      "confirmed",
      "conditional",
      "not-applicable",
      "unknown"
    ],
    "ruleRecord": {
      "requiredFields": [
        "id",
        "category",
        "owner",
        "source",
        "source-version-or-effective-date",
        "jurisdiction",
        "adoption-state",
        "applicability-state",
        "conditions",
        "decision",
        "blocked-outcome",
        "evidence"
      ]
    },
    "decisionPolicy": {
      "enforceOnlyWhen": {
        "adoptionState": "approved",
        "applicabilityStates": [
          "confirmed",
          "conditional"
        ],
        "conditionalRequires": [
          "jurisdiction",
          "conditions"
        ]
      },
      "failClosedWhen": [
        "missing-required-field",
        "unknown-applicability",
        "source-conflict",
        "missing-owner-approval"
      ],
      "onFailure": "block-adoption-or-enforcement-and-escalate-to-owner"
    },
    "placement": {
      "harnessConfig": [
        "source-classification",
        "placement-contract",
        "adoption-gates",
        "hard-safety-boundaries",
        "routing-and-bounded-defaults"
      ],
      "applicationContract": [
        "business-intent",
        "business-rules-and-conditions",
        "allowed-values-and-state-transitions",
        "jurisdiction-and-effective-source-citations"
      ],
      "implementation": [
        "executable-frontend-api-and-backend-behavior"
      ],
      "runtimeOverlay": [
        "ticket-module-route-reason-and-run-selection",
        "narrower-context-and-loop-budgets"
      ],
      "runtimeEvidence": [
        "execution-results",
        "api-db-observations",
        "coverage-and-gate-artifacts"
      ],
      "localSetupOrEnvironment": [
        "machine-specific-paths",
        "credentials-tokens-and-secrets"
      ]
    },
    "boundaries": {
      "do": [
        "classify-each-rule-before-use",
        "cite-the-primary-source-and-record-version-or-effective-date",
        "name-the-owner-jurisdiction-and-applicability",
        "keep-one-canonical-product-rule-and-reference-it",
        "trace-intent-through-implementation-enforcement-and-test-evidence",
        "fail-closed-on-unknown-or-conflicting-authority"
      ],
      "doNot": [
        "store-secrets-credentials-or-machine-paths-in-static-policy",
        "store-detailed-product-business-logic-in-harness-config",
        "promote-web-research-jira-confluence-or-derived-notes-automatically",
        "infer-legal-or-jurisdictional-applicability",
        "treat-ui-guards-or-passing-tests-as-backend-enforcement",
        "duplicate-the-same-rule-across-config-docs-and-specs"
      ]
    }
  },
  "documentation": {
    "sourcePrecedence": [
      "applicable-law-and-regulator-primary-source",
      "approved-internal-policy",
      "official-public-commitment",
      "live-source-api-db",
      "application-contract",
      "generated-repository-evidence",
      "approved-planning-decision",
      "jira-confluence-intent",
      "obsidian-derived-index"
    ],
    "owners": {
      "application": "Test-Case-Automation-Using-Claude-Agents/specs",
      "test-standards": "docs/framework/testing-standards/TESTS.md",
      "coverage": "docs/evidence/coverage-computed.json",
      "chain": "docs/planning/coverage/fullstack-chain-risk-matrix.md",
      "planning": "docs/planning/roadmap/effort-breakdown-by-module-and-subdashboard.md",
      "selectors": "docs/planning/data-cy-hook-backlog.md",
      "execution": "docs/framework/execution-strategy.md",
      "triage": "docs/framework/triage-runbook.md",
      "regression-sprint-records": "front-end-automation-e2e/docs/evidence/regression-effort/records"
    }
  }
}
